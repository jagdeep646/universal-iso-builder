# Keep repository text normalization deterministic on every developer machine.
* text=auto

# Source code and repository text use LF.
*.py text eol=lf
*.qml text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Native Windows command scripts use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never apply text conversion to binary release assets.
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.iso binary
